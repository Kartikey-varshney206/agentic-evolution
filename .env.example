# AI Civilization -- Environment Variables

# ── LLM Provider (pick ONE) ──
# Options: "nvidia" (default), "groq", "gemini", "openai", "ollama"
LLM_PROVIDER=nvidia

# ── NVIDIA NIM (RECOMMENDED -- free credits, Nemotron 550B) ──
# Get your key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ── Groq (free tier -- 30 requests/min, Gemma 2) ──
# Get your key at: https://console.groq.com
# GROQ_API_KEY=gsk_your-key-here
# GROQ_MODEL=gemma2-9b-it

# ── Gemini (free tier -- 15 RPM, replaces OpenAI) ──
# Get your key at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.0-flash

# ── OpenAI (paid) ──
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# ── Ollama (local -- free, unlimited) ──
# Install: https://ollama.com
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ── Logging ──
LOG_LEVEL=INFO
